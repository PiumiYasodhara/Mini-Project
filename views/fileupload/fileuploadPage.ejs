<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Upload Page</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-gray-900 text-white flex items-center justify-center min-h-screen"
  >
    <div
      class="w-full max-w-4xl shadow-lg rounded-lg overflow-hidden bg-gray-800 flex flex-col h-[90vh]"
    >
      <!-- Admin Header -->
      <div class="bg-gray-700 px-6 py-4 border-b border-gray-600">
        <h1 class="text-xl font-semibold">
          Admin Panel - Upload Files & Information
        </h1>
      </div>

      <!-- Upload Form Section -->
      <div class="p-6 space-y-6 flex-1 overflow-y-auto">
        <form id="uploadForm" class="space-y-4">
          <div>
            <label for="file" class="block text-sm font-medium text-gray-300"
              >Upload File</label
            >
            <input
              type="file"
              name="file"
              id="fileInput"
              class="mt-2 w-full p-4 bg-gray-700 text-white outline-none placeholder-gray-400 border border-gray-600 rounded-md"
            />
          </div>
          <div>
            <label for="info" class="block text-sm font-medium text-gray-300"
              >Enter Information</label
            >
            <textarea
              name="info"
              id="textInput"
              rows="4"
              class="mt-2 w-full p-4 bg-gray-700 text-white outline-none placeholder-gray-400 border border-gray-600 rounded-md"
              placeholder="Type some information here..."
            ></textarea>
          </div>
          <div class="flex justify-end">
            <!--fires submit event  -->
            <button
              type="submit"
              class="bg-blue-500 px-6 py-3 text-white font-medium rounded-md hover:bg-blue-600"
            >
              Upload
            </button>
          </div>
        </form>
      </div>

      <!-- Footer -->
      <div class="bg-gray-700 px-6 py-4 border-t border-gray-600">
        <p class="text-center text-sm text-gray-400">
          Admin Dashboard - File and Information Upload
        </p>
      </div>
    </div>

    <script>
      document
        .getElementById("uploadForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();

          const textInput = document.getElementById("textInput").value;
          const fileInput = document.getElementById("fileInput").files[0];

          // if (!fileInput) {
          //   alert("Please upload a PDF file.");
          //   return;
          // }

          const formData = new FormData();
          formData.append("text", textInput);
          formData.append("file", fileInput);

          try {
            const response = await fetch("/fileupload", {
              method: "POST",
              body: formData,
            });

            const result = await response.json();

            document.getElementById("responseMessage").textContent =
              result.message || "Upload successful!";
            document
              .getElementById("responseMessage")
              .classList.add("text-green-500");
          } catch (error) {
            document.getElementById("responseMessage").textContent =
              "An error occurred while uploading.";
            document
              .getElementById("responseMessage")
              .classList.add("text-red-500");
          }
        });
    </script>
  </body>
</html>
